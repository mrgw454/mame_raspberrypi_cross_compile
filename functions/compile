compile(){

## crosstool-ng doesn't like LD_LIBRARY_PATH set
unset LD_LIBRARY_PATH

## Find cross-compile tools
GCCBIN=$( ls -1d ${DIR_BUILD}/x-tools/${DSTR}/bin/*-gcc | head -n1 )
GPPBIN=$( ls -1d ${DIR_BUILD}/x-tools/${DSTR}/bin/*-g++ | head -n1 )
ARBIN=$(  ls -1d ${DIR_BUILD}/x-tools/${DSTR}/bin/*-ar  | head -n1 )

## Set per-arch tools
case ${APTARCH} in
armhf)
  MAMEPLATFORM=arm
  LDBIN=$( ls -1d ${DIR_BUILD}/x-tools/${DSTR}/bin/*-ld.gold )
  CUSTOMLDFLAGS=" -fuse-ld=gold -Wl,--long-plt"
  CUSTOMCFLAGS=" -fsigned-char"
  ;;
arm64)
  MAMEPLATFORM=arm64
  LDBIN=$( ls -1d ${DIR_BUILD}/x-tools/${DSTR}/bin/*-ld.gold )
  CUSTOMLDFLAGS=" -fuse-ld=gold"
  CUSTOMCFLAGS=" -fsigned-char"
  ;;
riscv64)
  MAMEPLATFORM=riscv64
  LDBIN=$( ls -1d ${DIR_BUILD}/x-tools/${DSTR}/bin/*-ld )
  #CUSTOMCPPFLAGS=" -mcmodel=medany"
  ;;
*)
  echo "Error: unknown architecture ${APTARCH}"
  exit 1
  ;;
esac

## Set linker path
MLIB="${DIR_LIB}/${DSTR}"
QT_PKGCONFIG_DIRS="${MLIB}/usr/lib/${LINARCH}/pkgconfig:${MLIB}/usr/lib/pkgconfig:${MLIB}/usr/share/pkgconfig"
USE_QTDEBUG_TARGET="${MAME_USE_QTDEBUG:-1}"

resolve_qt_settings() {
  export PKG_CONFIG_SYSROOT_DIR="${MLIB}"
  export PKG_CONFIG_LIBDIR="${QT_PKGCONFIG_DIRS}"
  unset PKG_CONFIG_PATH

  if pkg-config --exists Qt6Core Qt6Gui Qt6Widgets
  then
    QT_MAJOR=6
    QT_CFLAGS=$(pkg-config --cflags Qt6Core Qt6Gui Qt6Widgets)
    QT_LIBS=$(pkg-config --libs Qt6Core Qt6Gui Qt6Widgets)
    if command -v qmake6 >/dev/null 2>&1
    then
      QT_MOC="$(qmake6 -query QT_HOST_LIBEXECS)/moc"
    elif [ -x /usr/lib/qt6/libexec/moc ]
    then
      QT_MOC=/usr/lib/qt6/libexec/moc
    else
      echo "ERROR: Qt6 was found in ${MLIB}, but no host Qt6 moc was found"
      exit 1
    fi
  elif pkg-config --exists Qt5Core Qt5Gui Qt5Widgets
  then
    QT_MAJOR=5
    QT_CFLAGS=$(pkg-config --cflags Qt5Core Qt5Gui Qt5Widgets)
    QT_LIBS=$(pkg-config --libs Qt5Core Qt5Gui Qt5Widgets)
    QT_MOC=$(command -v moc)
    if [ -z "${QT_MOC}" ]
    then
      echo "ERROR: Qt5 was found in ${MLIB}, but no host moc was found"
      exit 1
    fi
  else
    echo "ERROR: No supported Qt development package set was found in ${MLIB}"
    echo "Checked pkg-config paths: ${QT_PKGCONFIG_DIRS}"
    exit 1
  fi
}

rewrite_generated_makefiles() {
  QTMAKE="${DIR_BUILD}/src/${MAMEFORK}/build/projects/sdl/mame/gmake-linux"
  GENERATED_FILES=$(find "${QTMAKE}" -maxdepth 1 \( -name '*.make' -o -name 'Makefile' \) -print)

  if [ -z "${GENERATED_FILES}" ] || [ ! -f "${QTMAKE}/Makefile" ] || [ ! -f "${QTMAKE}/mame.make" ]
  then
    echo "ERROR: Expected generated MAME makefiles were not found in ${QTMAKE}"
    exit 1
  fi

  echo "Rewriting generated MAME makefiles for cross-toolchain from ${MLIB}"

  SYSROOT_CFLAGS_SPACED=" -I${MLIB}/usr/include -I${MLIB}/usr/include/${LINARCH} -I${MLIB}/usr/include/SDL2"
  SYSROOT_LDFLAGS_SPACED=" -L${MLIB}/usr/lib -L${MLIB}/usr/lib/${LINARCH} -L${MLIB}/usr/lib/${LINARCH}/pulseaudio -Wl,-rpath-link,${MLIB}/usr/lib -Wl,-rpath-link,${MLIB}/usr/lib/${LINARCH} -Wl,-rpath-link,${MLIB}/usr/lib/${LINARCH}/pulseaudio"

  GCCBIN="${GCCBIN}" GPPBIN="${GPPBIN}" ARBIN="${ARBIN}" \
  SYSROOT_CFLAGS_SPACED="${SYSROOT_CFLAGS_SPACED}" \
  SYSROOT_LDFLAGS_SPACED="${SYSROOT_LDFLAGS_SPACED}" \
  perl -0pi -e '
    s@^CC\s*=.*$@CC = $ENV{GCCBIN}@mg;
    s@^CXX\s*=.*$@CXX = $ENV{GPPBIN}@mg;
    s@^AR\s*=.*$@AR = $ENV{ARBIN}@mg;
    s@(?:^| )-m32(?= |$)@@mg;
    s@(?:^| )-m64(?= |$)@@mg;
    s@^(\s*ALL_CPPFLAGS\s*\+=\s*\$\(CPPFLAGS\))@$1$ENV{SYSROOT_CFLAGS_SPACED}@mg;
    s@^(\s*ALL_LDFLAGS\s*\+=\s*\$\(LDFLAGS\))@$1$ENV{SYSROOT_LDFLAGS_SPACED}@mg;
    s@[ ]{2,}@ @mg;
  ' ${GENERATED_FILES}

  if ! rg -n --fixed-strings "CC = ${GCCBIN}" "${QTMAKE}" >/dev/null
  then
    echo "ERROR: Failed to inject the expected cross-compiler path into generated makefiles"
    exit 1
  fi
}

rewrite_qtdebug_stub_makefiles() {
  QTMAKE="${DIR_BUILD}/src/${MAMEFORK}/build/projects/sdl/mame/gmake-linux"

  if [ ! -f "${QTMAKE}/qtdbg_sdl.make" ]
  then
    echo "ERROR: Missing generated Qt debugger makefile in ${QTMAKE}"
    exit 1
  fi

  echo "Rewriting generated Qt debugger stub makefile for USE_QTDEBUG=0"

  perl -0pi -e '
    s@\s+-I\$\(shell qmake(?:6)? -query QT_INSTALL_HEADERS\)@@g;
    s@[ ]{2,}@ @mg;
  ' "${QTMAKE}/qtdbg_sdl.make"
}

rewrite_qtdebug_makefiles() {
  QTMAKE="${DIR_BUILD}/src/${MAMEFORK}/build/projects/sdl/mame/gmake-linux"
  QT_PATTERN="Qt${QT_MAJOR}Core|Qt${QT_MAJOR}Gui|Qt${QT_MAJOR}Widgets"

  if [ ! -f "${QTMAKE}/qtdbg_sdl.make" ] || [ ! -f "${QTMAKE}/mame.make" ]
  then
    echo "ERROR: Expected generated Qt debugger makefiles were not found in ${QTMAKE}"
    exit 1
  fi

  echo "Rewriting generated Qt debugger makefiles for Qt${QT_MAJOR} from ${MLIB}"

  QT_CFLAGS_SPACED=" ${QT_CFLAGS}"
  QT_LIBS_SPACED=" ${QT_LIBS}"

  QT_CFLAGS_SPACED="${QT_CFLAGS_SPACED}" perl -0pi -e 's@\s+-I\$\(shell qmake(?:6)? -query QT_INSTALL_HEADERS\)@$ENV{QT_CFLAGS_SPACED}@g' "${QTMAKE}/qtdbg_sdl.make"
  QT_MOC="${QT_MOC}" perl -0pi -e 's@\$\((?:SILENT)\)\s+(?:/usr/lib/qt6/libexec/moc|/usr/lib/qt5/bin/moc|moc-qt5|moc)(?=\$\(MOCINCPATH\))@\$(SILENT) $ENV{QT_MOC}@g' "${QTMAKE}/qtdbg_sdl.make"
  perl -0pi -e 's@\s+-L\$\(shell qmake(?:6)? -query QT_INSTALL_LIBS\)@@g' "${QTMAKE}/qtdbg_sdl.make" "${QTMAKE}/mame.make"
  QT_LIBS_SPACED="${QT_LIBS_SPACED}" perl -0pi -e 's@\s+-lQt[56]Core\s+-lQt[56]Gui\s+-lQt[56]Widgets@$ENV{QT_LIBS_SPACED}@g' "${QTMAKE}/mame.make"

  if ! rg -n --fixed-strings "${QT_MOC}" "${QTMAKE}/qtdbg_sdl.make" >/dev/null
  then
    echo "ERROR: Failed to inject the expected moc path into qtdbg_sdl.make"
    exit 1
  fi

  if ! rg -n -e "${QT_PATTERN}" "${QTMAKE}/mame.make" >/dev/null
  then
    echo "ERROR: Failed to inject the expected Qt${QT_MAJOR} link libraries into mame.make"
    exit 1
  fi
}

install_useroptions() {
  USEROPTIONS_SOURCE="${DIR_BASE}/conf/useroptions.mak"
  USEROPTIONS_TARGET="${DIR_BUILD}/src/${MAMEFORK}/useroptions.mak"

  if [ ! -f "${USEROPTIONS_SOURCE}" ]; then
    echo "ERROR: Missing useroptions template: ${USEROPTIONS_SOURCE}"
    exit 1
  fi

  cp "${USEROPTIONS_SOURCE}" "${USEROPTIONS_TARGET}"
  echo "Installed useroptions.mak from ${USEROPTIONS_SOURCE}"
}

ensure_sdl_config_header() {
  SDL_CONFIG_DIR="${MLIB}/usr/include/SDL2"
  SDL_REAL_SOURCE="${MLIB}/usr/include/${LINARCH}/SDL2/_real_SDL_config.h"
  SDL_REAL_TARGET="${SDL_CONFIG_DIR}/_real_SDL_config.h"

  if [ ! -f "${SDL_CONFIG_DIR}/SDL_config.h" ]; then
    return
  fi

  if [ -f "${SDL_REAL_TARGET}" ]; then
    return
  fi

  if [ ! -f "${SDL_REAL_SOURCE}" ]; then
    echo "ERROR: Missing SDL compatibility header: ${SDL_REAL_SOURCE}"
    exit 1
  fi

  cp "${SDL_REAL_SOURCE}" "${SDL_REAL_TARGET}"
  echo "Installed SDL compatibility header: ${SDL_REAL_TARGET}"
}

ensure_bgfx_gl_headers() {
  BGFX_KHRONOS_DIR="${DIR_BUILD}/src/${MAMEFORK}/3rdparty/bgfx/3rdparty/khronos"
  GL_SOURCE_DIR="${MLIB}/usr/include/GL"
  GL_TARGET_DIR="${BGFX_KHRONOS_DIR}/GL"

  if [ ! -d "${BGFX_KHRONOS_DIR}" ]; then
    return
  fi

  if [ -f "${GL_TARGET_DIR}/gl.h" ]; then
    return
  fi

  if [ ! -d "${GL_SOURCE_DIR}" ]; then
    echo "ERROR: Missing GL headers in sysroot: ${GL_SOURCE_DIR}"
    exit 1
  fi

  cp -r "${GL_SOURCE_DIR}" "${GL_TARGET_DIR}"
  echo "Installed BGFX GL headers: ${GL_TARGET_DIR}"
}

verify_target_binary() {
  MAME_BIN="${DIR_BUILD}/src/${MAMEFORK}/mame"

  if [ ! -f "${MAME_BIN}" ]; then
    echo "ERROR: Expected target binary was not produced: ${MAME_BIN}"
    exit 1
  fi

  BININFO=$(file "${MAME_BIN}")
  echo "Built target binary: ${BININFO}"

  if ! echo "${BININFO}" | grep -qi 'aarch64'; then
    echo "ERROR: Build completed but produced a non-arm64 binary"
    exit 1
  fi
}

echo "Preparing MAME..."

mkdir -p "${DIR_BUILD}/src"
cd "${DIR_BUILD}/src" || exit 1

if [ -d "${MAMEFORK}" ]
then
  echo "Found existing "${MAMEFORK}" src, updating it..."
  cd "${DIR_BUILD}/src/${MAMEFORK}" || exit 1
  git clean -dfx
  make clean
  git reset --hard HEAD
  git checkout master
  git pull --recurse-submodules=yes
else
  echo "No ${MAMEFORK} source found, cloning from GitHub..."
  cd "${DIR_BUILD}/src" || exit 1
  git clone --recursive "${GIT}" "${MAMEFORK}"
fi

## Check out the correct tag
## MAME tags are in the form mame0123 for MAME 0.123
## GroovyMAME tags are in the form gm0123sr321a for GroovyMAME 0.123 with Switchres 3.2.1

cd "${DIR_BUILD}/src/${MAMEFORK}" || exit 1
# MAME
if [ "${MAMEFORK}" == "mame" ]
then
  if [ "${MAMEVER}" == "latest" ]
  then
    MAMETAG=$(git tag | grep ^mame | tail -n1)
    MAMENUM=0.$( echo ${MAMETAG} | awk -F '0' '{print $2}')
  else
    MAMESUFF=$(echo ${MAMEVER} | tr -d '.')
    MAMETAG=mame${MAMESUFF}
    MAMENUM=${MAMEVER}
  fi
elif  [ "${MAMEFORK}" == "groovymame" ]
then
  if [ "${MAMEVER}" == "latest" ]
  then
    MAMETAG=$(git tag | grep ^gm | tail -n1)
    MAMENUM=0.$( echo ${MAMETAG} | awk -F '0' '{print $2}'| awk -F 's' '{print $1}' )
  else
    MAMESUFF=$(echo ${MAMEVER} | tr -d '.')
    MAMETAG=$(git tag | grep ^gm | grep ${MAMESUFF} | tail -n1)
    MAMENUM=${MAMEVER}
  fi
else
  echo "${MAMEFORK} unable to find tag for version ${MAMEVER}"
  exit 1
fi

git checkout ${MAMETAG}

echo "Building MAME"

cd "${DIR_BUILD}/src/${MAMEFORK}" || exit 1

echo "Source code for ${MAMEFORK} version ${MAMETAG} ready to be compiled for ${DSTR}"

mkdir -p "${DIR_BUILD}/output"
OUTFILE="${MAMEFORK}_${MAMENUM}_${DSTR}.7z"
if [ -f "${DIR_BUILD}/output/${OUTFILE}" ]
then
  echo "${DIR_BUILD}/output/${OUTFILE} exists, not overwriting"
  echo "To rebuild, rename or delete ${DIR_BUILD}/output/${OUTFILE}"
  echo "and re-run this script"
  exit 1
fi

echo "Compiling with"
echo "gcc : ${GCCBIN}"
echo "g++ : ${GPPBIN}"
echo "ld  : ${LDBIN}"
echo "ar  : ${ARBIN}"
echo "Qt debugger enabled: ${USE_QTDEBUG_TARGET}"

if [ "${USE_QTDEBUG_TARGET}" = "1" ]; then
  resolve_qt_settings
  echo "Qt  : Qt${QT_MAJOR} from ${MLIB}"
  echo "moc : ${QT_MOC}"
fi

install_useroptions
ensure_sdl_config_header
ensure_bgfx_gl_headers

make clean

  # 1) Build host tools (genie) with host compiler
  make \
    REGENIE=1 \
    TOOLS=1 \
    NOWERROR=1 \
    USE_QTDEBUG=${USE_QTDEBUG_TARGET} \
    PLATFORM=${MAMEPLATFORM} \
    TARGETOS=linux \
    -j${CPUS}

  rewrite_generated_makefiles

  if [ "${USE_QTDEBUG_TARGET}" = "1" ]; then
    rewrite_qtdebug_makefiles
  else
    rewrite_qtdebug_stub_makefiles
  fi

  # 2) Build MAME for target with cross toolchain
  make \
    CROSS_BUILD=1 \
    TOOLS=1 \
    NOWERROR=1 \
    USE_QTDEBUG=${USE_QTDEBUG_TARGET} \
    CONFIG=release \
    PLATFORM=${MAMEPLATFORM} \
    CFLAGS+=" -I ${MLIB}/usr/include" \
    CFLAGS+=" -I ${MLIB}/usr/include/${LINARCH}" \
    CFLAGS+=" -L ${MLIB}/usr/lib" \
    CFLAGS+=" -L ${MLIB}/usr/lib/${LINARCH}" \
    CFLAGS+=" -U_FORTIFY_SOURCE" \
    CFLAGS+=" ${CUSTOMCFLAGS}" \
    CXXFLAGS+=" -I ${MLIB}/usr/include" \
    CXXFLAGS+=" -I ${MLIB}/usr/include/${LINARCH}" \
    CXXFLAGS+=" -L ${MLIB}/usr/lib" \
    CXXFLAGS+=" -L ${MLIB}/usr/lib/${LINARCH}" \
    CXXFLAGS+=" -U_FORTIFY_SOURCE" \
    CXXFLAGS+=" ${CUSTOMCFLAGS}" \
    CPPFLAGS+=" -I ${MLIB}/usr/include" \
    CPPFLAGS+=" -I ${MLIB}/usr/include/${LINARCH}" \
    CPPFLAGS+=" -L ${MLIB}/usr/lib" \
    CPPFLAGS+=" -L ${MLIB}/usr/lib/${LINARCH}" \
    CPPFLAGS+=" -U_FORTIFY_SOURCE" \
    CPPFLAGS+=" ${CUSTOMCFLAGS}" \
    LDFLAGS+=" -L ${MLIB}/usr/lib" \
    LDFLAGS+=" -L ${MLIB}/usr/lib/${LINARCH}" \
    LDFLAGS+=" ${CUSTOMLDFLAGS}" \
    ARCHOPTS+=" -Wl,-R,${MLIB}/usr/lib" \
    ARCHOPTS+=" -Wl,-R,${MLIB}/usr/lib/${LINARCH}" \
    ARCHOPTS+=" -Wl,-R,${MLIB}/lib" \
    ARCHOPTS+=" -Wl,-R,${MLIB}/lib/${LINARCH}" \
    ARCHOPTS+=" -Wl,-R,${MLIB}/usr/lib/${LINARCH}/pulseaudio" \
    ARCHOPTS+=" -Wl,-R,${MLIB}/opt/vc/lib" \
    ARCHOPTS+=" -Wl,-rpath,${MLIB}/usr/lib" \
    ARCHOPTS+=" -Wl,-rpath,${MLIB}/usr/lib/${LINARCH}" \
    ARCHOPTS+=" -Wl,-rpath,${MLIB}/lib" \
    ARCHOPTS+=" -Wl,-rpath,${MLIB}/lib/${LINARCH}" \
    ARCHOPTS+=" -Wl,-rpath,${MLIB}/usr/lib/${LINARCH}/pulseaudio" \
    ARCHOPTS+=" -Wl,-rpath,${MLIB}/opt/vc/lib" \
    ARCHOPTS+=" -Wl,-rpath-link,${MLIB}/usr/lib" \
    ARCHOPTS+=" -Wl,-rpath-link,${MLIB}/usr/lib/${LINARCH}" \
    ARCHOPTS+=" -Wl,-rpath-link,${MLIB}/lib" \
    ARCHOPTS+=" -Wl,-rpath-link,${MLIB}/lib/${LINARCH}" \
    ARCHOPTS+=" -Wl,-rpath-link,${MLIB}/usr/lib/${LINARCH}/pulseaudio" \
    ARCHOPTS+=" -Wl,-rpath-link,${MLIB}/opt/vc/lib" \
    TARGETOS=linux \
    OVERRIDE_CC="${GCCBIN}" \
    OVERRIDE_CXX="${GPPBIN}" \
    OVERRIDE_LD="${LDBIN}" \
    OVERRIDE_AR="${ARBIN}" \
    linux_x64 \
    -j${CPUS}

MAKE_STATUS=$?
if [ $MAKE_STATUS -ne 0 ]; then
  echo "Compile failed"
  echo "Check the contents of the log file:"
  echo "${DIR_BUILD}/log/${OPERATION}_${DSTR}.log"
  exit 1
else
  verify_target_binary
  echo "Compile successful"
  echo "Compressing to ${DIR_BUILD}/output/${OUTFILE}"
  source "${DIR_FUNC}/compress"
  compress
  echo "All done."
fi

}
